{
    "name": "tweakwise/magento2-attributelanding-tweakwise",
    "description": "Provides compatibility between Attribute landing module and Tweakwise module.",
    "license": "OSL-3.0",
    "require": {
        "php": "^8.1",
        "emico/m2-attributelanding": ">=5.1.0",
        "tweakwise/magento2-tweakwise": ">=8.4.0"
    },
    "require-dev": {
        "emico/code-quality": "~10.6.0",
        "symfony/finder": "^6.4.0"
    },
    "type": "magento2-module",
    "replace": {
        "emico/m2-attributelanding-tweakwise": "v2.4.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Tweakwise\\AttributeLandingTweakwise\\": "src"
        }
    },
    "repositories": {
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        "emico/code-quality": {
            "type": "vcs",
            "url": "https://git.emico.io/composer-packages/generic/codequality.git"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "phpro/grumphp": true,
            "emico/code-quality": true
        },
        "preferred-install": {
            "emico/code-quality": "dist"
        }
    }
}
